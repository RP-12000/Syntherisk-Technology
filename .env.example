# 复制成 .env 再改。什么都不填也能跑：SQLite + 进程内任务队列 + 内置演示路线，不调大模型。
# .env 不进代码仓库（见 .gitignore）；密钥只写在 .env 里，不要写进代码。

APP_ENV=development
HOST=127.0.0.1
PORT=8000
# 前端开发服务器的地址，多个用逗号分开
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------- 数据库（M0）
# 留空 = 本地 SQLite（var/syntherisk.db）。生产用 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://用户名:密码@主机:5432/syntherisk
DATABASE_URL=

# ---------------------------------------------------------------- 密钥
# 开发环境留空会自动生成并存进 var/dev_secrets.json；生产环境（APP_ENV=production）必须自己填。
# DATA_ENCRYPTION_KEY 用来加密客户库存、目标结构、分析结果和实验回填：丢了就解不开已有数据，务必备份。
# 生成方法：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
DATA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- 任务队列（MQ）
# inprocess = 任务在 API 进程里跑（本地开发）；redis = 另起 Worker 进程：python -m syntherisk.worker
QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- M3 逆合成搜索
# auto = 填了 AIZYNTH_CONFIG 就用 AiZynthFinder，否则用内置演示路线（只认布洛芬、阿司匹林）
M3_ENGINE=auto
# AiZynthFinder 的 config.yml 在哪，比如 AIZYNTH_CONFIG=data\external\aizynth\config.yml
# 这个文件不用单独去下载。先建好文件夹 data\external\aizynth，再运行
#   .venv\Scripts\download_public_data.exe data\external\aizynth
# 它会把公开模型（约 0.8 GB）下载到那个文件夹，并在里面自动生成 config.yml。详见 README 的“AiZynthFinder”一节
AIZYNTH_CONFIG=
# 一般留空：AiZynthFinder 和后端装在同一个环境（.venv）里，后端用自己的 Python 去跑它。
# 只有把它装在别的环境里时才要填那个环境的 Python，路径可以写相对项目根目录的
AIZYNTH_PYTHON=
AIZYNTH_STOCK=zinc
AIZYNTH_EXPANSION_POLICY=uspto
AIZYNTH_FILTER_POLICY=uspto
# 最多搜几轮、最长搜多少秒（先到哪个算哪个）。轮数越多越容易找到完整路线，也越慢：
# 实测布洛芬 100 轮找不到完整路线，400 轮约 35 秒能找到 10 条
AIZYNTH_ITERATION_LIMIT=400
AIZYNTH_TIME_LIMIT=120
# 单步模型每一步最多试多少个反应模板，以及模型给的概率累计到多少就不再往下试。AiZynthFinder 默认是 50 和 0.995；
# 实测 50 个时有些合理的拆法排得太靠后、根本试不到（README 的“AiZynthFinder”一节有表），所以默认 300 和 1.0
AIZYNTH_CUTOFF_NUMBER=300
AIZYNTH_CUTOFF_CUMULATIVE=1.0

# ---------------------------------------------------------------- 外部免费接口
# PubChem：名称 / CAS 转结构（M1）、GHS 危害分类（M6）。关掉后只用内置试剂表。
ENABLE_PUBCHEM=true
# OPSIN：英文系统命名转结构
ENABLE_OPSIN=true
# Crossref / OpenAlex：给有 DOI 的先例补文献题目和作者
ENABLE_LITERATURE_METADATA=false
CONTACT_EMAIL=

# ---------------------------------------------------------------- 大模型（M2 约束解析、M11 写说明、M12 问答）
# offline = 不调大模型，用规则和模板（结果里会标明）
# 换厂商只改这几行。客户的分子结构只走默认不拿 API 数据训练的付费接口。
LLM_PROVIDER=offline

# 用 Claude（Anthropic 官方 SDK）。LLM_MODEL 留空 = claude-haiku-5-5
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=

# 用任何兼容 OpenAI Chat Completions 的接口（地址和型号以各家文档为准）
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=
# 厂商不支持按 JSON Schema 约束输出时，改成 json_object
# LLM_JSON_MODE=json_schema

LLM_EFFORT=low
# 给前几条路线写说明（PPT：前 3 条，每次分析约 16 次调用）
EXPLAIN_TOP_ROUTES=3

# ---------------------------------------------------------------- M6 管制清单按哪些地区提示
CONTROLLED_JURISDICTIONS=CA,US,CN,TW

# ---------------------------------------------------------------- M13 报告
# PDF 里的中文字体。留空会自动找系统字体（Windows 上是微软雅黑）；Linux 服务器上请指定一个 TrueType 中文字体文件
REPORT_FONT_PATH=

# ---------------------------------------------------------------- 演示账号（python -m syntherisk.cli seed-demo）
DEMO_USER_EMAIL=kelvin.hu@syntherisk.com
DEMO_USER_PASSWORD=12345678
DEMO_ORG_NAME=示例课题组
